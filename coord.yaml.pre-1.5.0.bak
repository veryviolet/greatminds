session: greatminds-dev
project_dir: /opt/greatminds
windows:
- name: planner
  role: ARCHITECT-PLANNER
  tool: codex
  mode: chat
- name: reviewer
  role: ARCHITECT-REVIEWER
  tool: codex
  mode: driven
- name: dev
  role: DEVELOPER
  tool: claude
  mode: driven
- name: ui
  role: UI-DEVELOPER
  tool: claude
  mode: driven
- name: writer
  role: TECHNICAL-WRITER
  tool: codex
  mode: driven
- name: tester
  role: TESTER
  tool: claude
  mode: driven
- name: reader
  role: READER
  tool: claude
  mode: driven
- name: explorer
  role: EXPLORER
  tool: codex
  mode: driven
- name: stand
  role: STAND-KEEPER
  tool: claude
  mode: driven
- name: maintainer
  role: MAINTAINER
  tool: claude
  mode: loop
- name: ops
  role: ""
  tool: bash

report:
  mode: gh
  upstream_repo: veryviolet/greatminds
