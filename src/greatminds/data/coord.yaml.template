# Generated by `greatminds setup`. Edit freely after first run; setup
# will never overwrite an existing coord.yaml (delete + re-run to start over).
#
# `session` MUST be unique per project on a single user — the systemd
# template unit instance name (greatminds-daemon@<session>.service) and the
# tmux session name both derive from it.
#
# Two kinds of entries under `windows:`:
#   - PANE roles (mode: chat | loop) get a real tmux window. Only the
#     human-facing / resident roles are paned: PLANNER (interactive
#     chat), MAINTAINER (self-loop watchdog), plus the `dashboard`
#     pane (mode: dashboard) which runs the read-only live status
#     table `greatminds dashboard` (agents / tasks / stand).
#   - DRIVEN roles (mode: driven) get NO tmux window. coordd runs each
#     of their turns as a managed subprocess (claude -p / codex
#     app-server), holds the per-role run-lock for the turn, and
#     captures output to coordination/.turns/<role>-<ts>.log. They are
#     listed here only so coordd knows each role's tool (claude/codex);
#     `greatminds launch` skips creating a window for them.
session: __SESSION__
project_dir: __PROJECT_DIR__
windows:
  # --- paned, human-facing / resident roles ---
  - name: planner
    role: ARCHITECT-PLANNER
    tool: codex
    mode: chat
  - name: maintainer
    role: MAINTAINER
    tool: claude
    mode: loop
  - name: dashboard
    role: ""
    tool: bash
    # Read-only live status table. `greatminds launch` auto-runs
    # `greatminds dashboard` here (agents / tasks / stand); pure
    # observer — no role, registers nothing.
    mode: dashboard
  - name: live
    role: LIVE-DEVELOPER
    tool: claude
    # Interactive, USER-paced. mode:staged means launch creates the pane
    # and PRE-TYPES the start-agent command but does NOT submit it — the
    # USER starts/stops the live session themselves when they want one.
    mode: staged
  # --- driven roles (no pane; coordd drives each turn as a subprocess) ---
  - name: reviewer
    role: ARCHITECT-REVIEWER
    tool: codex
    mode: driven
  - name: dev
    role: DEVELOPER
    tool: claude
    mode: driven
  - name: ui
    role: UI-DEVELOPER
    tool: claude
    mode: driven
  - name: writer
    role: TECHNICAL-WRITER
    tool: codex
    mode: driven
  - name: tester
    role: TESTER
    tool: claude
    mode: driven
  - name: reader
    role: READER
    tool: claude
    mode: driven
  - name: explorer
    role: EXPLORER
    tool: codex
    mode: driven
  - name: stand
    role: STAND-KEEPER
    tool: claude
    mode: driven
