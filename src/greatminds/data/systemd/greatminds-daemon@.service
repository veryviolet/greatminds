[Unit]
Description=greatminds coordination daemon for project %i
After=default.target

[Service]
Type=simple
# __GREATMINDS_BIN__ is substituted at install time by `greatminds daemon
# install` to the absolute path of the running greatminds binary (resolved
# via shutil.which). This makes per-project venv installs (`uv add
# greatminds`) work without requiring a global ~/.local/bin/greatminds.
ExecStart=__GREATMINDS_BIN__ coordd --project %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
